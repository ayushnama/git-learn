# Optional public canonical origin. Set your real domain before a production build.
# HTTP(S) origin only; no subpath, credentials, query or hash.
# Leave blank during local development to use the current browser origin.
# VITE_ values are public browser configuration; do not put secrets here.
VITE_SITE_URL=

# Default is mock. Only switch to api when your future catalog endpoint exists.
VITE_CATALOG_SOURCE=mock
# Example shape: an HTTP(S) origin with an optional /api path. No secrets here.
VITE_API_BASE_URL=
# Optional override for the supplied logo in public/brand/.
# Leave blank to use /brand/marbello-logo.png. Failed images use a text fallback.
VITE_BRAND_LOGO_URL=
